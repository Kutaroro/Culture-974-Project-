{% extends 'base.html.twig' %}

{% block title %}
    {{ block('titre_page') is defined ? block('titre_page') : 'Créer un événement' }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.tailwindcss.com"></script>
{% endblock %}

{% block main %}
    <div class="min-h-screen flex justify-center py-12 bg-gray-50">
        <div class="container mx-auto px-4 max-w-2xl">
            
            {# Titre de la page #}
            <h1 class="text-4xl font-extrabold text-center text-gray-800 mb-10">
                {% if app.request.attributes.get('_route') == 'app_evenement_edit' %}
                    Modifier l'événement
                {% else %}
                    Créer un nouvel événement
                {% endif %}
            </h1>

            {# Carte du formulaire #}
            <div class="bg-white shadow-lg rounded-xl p-8 border border-gray-200">
                
                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                    {# --- Gestion des erreurs globales --- #}
                    {{ form_errors(form) }}

                    {# --- Titre --- #}
                    <div>
                        {{ form_label(form.titre, 'Titre de l\'événement', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.titre, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors outline-none', 'placeholder': 'Ex: Concert de Jazz'}}) }}
                        {{ form_errors(form.titre, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
                    </div>

                    {# --- Catégorie --- #}
                    {# Adapte le nom du champ si ce n'est pas 'categoryId' ou 'category' #}
                    {% if form.categoryId is defined %}
                    <div>
                        {{ form_label(form.categoryId, 'Catégorie', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.categoryId, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors outline-none bg-white'}}) }}
                        {{ form_errors(form.categoryId) }}
                    </div>
                    {% endif %}

                    {# --- Lieu & Date (Grille 2 colonnes) --- #}
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.lieu, 'Lieu', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                            {{ form_widget(form.lieu, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors outline-none'}}) }}
                            {{ form_errors(form.lieu) }}
                        </div>
                        <div>
                            {{ form_label(form.date, 'Date', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                            {{ form_widget(form.date, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors outline-none'}}) }}
                            {{ form_errors(form.date) }}
                        </div>
                    </div>

                    {# --- Image (URL ou Fichier) --- #}
                    <div>
                        {{ form_label(form.image, 'Image de couverture', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {# Si c'est un champ FileType, le style changera un peu, ici je présume TextType ou FileType standard #}
                        {{ form_widget(form.image, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors outline-none'}}) }}
                        <p class="text-xs text-gray-500 mt-1">L'URL de l'image ou le fichier à uploader.</p>
                        {{ form_errors(form.image) }}
                    </div>

                    {# --- Description --- #}
                    <div>
                        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors outline-none h-32 resize-y'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                    {# --- Reste du formulaire (token, champs cachés oubliés) --- #}
                    {{ form_rest(form) }}

                    {# --- Boutons d'action --- #}
                    <div class="flex items-center justify-between pt-4">
                        <a href="{{ path('app_evenement_index') }}" class="text-gray-600 hover:text-gray-900 font-medium transition-colors">
                            ← Retour à la liste
                        </a>
                        <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-bold shadow-md hover:bg-indigo-700 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5">
                            {{ button_label|default('Enregistrer l\'événement') }}
                        </button>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}