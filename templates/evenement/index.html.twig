{% extends 'base.html.twig' %}

{% block title %}Evenement index{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
{% endblock %}

{% block main %}
    <div class="min-h-screen flex justify-center py-8">
        <div class="container mx-auto px-4">
            <h1 class="text-4xl font-extrabold text-center text-gray-800 mb-10">Événements à Venir</h1>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for evenement in evenements %}
                    <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="group">
                        <div class="bg-white shadow-lg rounded-xl p-6 hover:shadow-2xl transition-shadow duration-300 border border-gray-200 hover:border-indigo-300">
                            <h2 class="text-2xl font-bold text-gray-800 mb-3 group-hover:text-indigo-600 transition-colors">{{ evenement.titre }}</h2>
                            <p class="text-sm text-indigo-600 font-medium mb-4 bg-indigo-50 px-3 py-1 rounded-full inline-block">
                                {{ evenement.categoryId.name }}
                            </p>
                            {% if evenement.image %}
                                <img src="{{ asset('uploads/images/' ~ evenement.image) }}" alt="{{ evenement.titre }}" class="w-full h-48 object-cover rounded-lg mb-4 shadow-md">
                            {% endif %}
                            <p class="text-gray-700 mb-4 line-clamp-3">{{ evenement.description }}</p>
                            <div class="space-y-2">
                                <p class="text-sm text-gray-600 flex items-center">
                                     <span class="ml-2 font-medium">{{ evenement.date ? evenement.date|date('d/m/Y') : 'Date non spécifiée' }}</span>
                                </p>
                                <p class="text-sm text-gray-600 flex items-center">
                                    <span class="ml-2 font-medium">{{ evenement.lieu }}</span>
                                </p>
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="col-span-full text-center py-12">
                        <p class="text-xl text-gray-500">Aucun événement trouvé pour le moment.</p>
                        <p class="text-gray-400 mt-2">Revenez bientôt pour découvrir de nouveaux événements !</p>
                    </div>
                {% endfor %}
            </div>

            <div class="text-center mt-12">
                <a href="{{ path('app_evenement_new') }}" class="inline-flex items-center bg-gradient-to-r from-indigo-500 to-purple-600 text-white px-8 py-3 rounded-full font-semibold hover:from-indigo-600 hover:to-purple-700 transition-all duration-300 shadow-lg hover:shadow-xl">
                    Créer un Nouvel Événement
                </a>
            </div>
        </div>
    </div>
{% endblock %}
