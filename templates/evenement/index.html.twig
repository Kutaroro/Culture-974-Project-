{% extends 'base.html.twig' %}

{% block title %}Evenement index{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

{% endblock %}

{% block main %}


    <h1 class="text-2xl font-bold mb-6">Evenement index</h1>

    <div class="flex flex-wrap gap-6 justify-center align-center">
        {% for evenement in evenements %}
            <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}">
                <div class="bg-white shadow-md rounded-lg p-4">
                    <h2 class="text-xl font-bold mb-2">{{ evenement.titre }}</h2>
                    <p class="mb-2"><strong>Lieu:</strong> {{ evenement.categoryId.name  }}</p>
                    {% if evenement.image %}
                        <img src="{{ asset('uploads/images/' ~ evenement.image) }}" alt="{{ evenement.titre }}" class="w-full h-48 object-cover rounded mb-2">
                    {% endif %}
                    <p class="text-gray-600 mb-2">{{ evenement.description }}</p>
                    <p class="mb-1"><strong>Date:</strong> {{ evenement.date ? evenement.date|date('d/m/Y') : '' }}</p>
                    <p class="mb-2"><strong>Lieu:</strong> {{ evenement.lieu }}</p>
                </div>
            </a>
        {% else %}
            <p class="col-span-full text-center text-gray-500">Aucun événement trouvé</p>
        {% endfor %}
    </div>

    <div class="container mx-auto px-4 py-4">
        <a href="{{ path('app_evenement_new') }}" class="inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Créer un nouvel événement</a>
    </div>
{% endblock %}
