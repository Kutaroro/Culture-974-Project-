{% extends 'base.html.twig' %}

{% block title %}
	{{ evenement.titre }}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/event-detail.css') }}">
{% endblock %}

{% block main %}
	<div class="event-detail-container">
		<div class="event-hero">
			{% if evenement.image %}
				<img src="{{ asset(evenement.image) }}" alt="{{ evenement.titre }}">
			{% else %}
				<img src="https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" alt="Event Image">
			{% endif %}
			<div class="event-hero-overlay">
				<span class="category-badge">{{ evenement.categoryId.name }}</span>
			</div>
		</div>

		<div class="event-card">
			<div class="event-header">
				<h1 class="event-title">{{ evenement.titre }}</h1>
			</div>

			<div class="event-meta">
				<div class="meta-item">
					<span class="meta-label">Date de l'événement</span>
					<span class="meta-value">📅
						{{ evenement.date ? evenement.date|date('d F Y') : 'Date non définie' }}</span>
				</div>
				<div class="meta-item">
					<span class="meta-label">Lieu</span>
					<span class="meta-value">📍
						{{ evenement.lieu }}</span>
				</div>
				<div class="meta-item">
					<span class="meta-label">Organisateur</span>
					<span class="meta-value">🏢 Culture 974</span>
				</div>
			</div>

			<div class="event-description">
				<p>{{ evenement.description|nl2br }}</p>
			</div>

			<div class="event-actions">
				<a href="{{ path('app_inscription_event', {'id': evenement.id}) }}" class="btn-register">
					<span>S'inscrire à l'événement</span>
					<svg width="20" height="20" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>

				<a href="{{ path('app_evenement_index') }}" class="btn-back">← Retour aux événements</a>

				{% if is_granted('ROLE_ADMIN') %}
					<div class="admin-controls">
						<a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn-admin btn-edit">Modifier</a>
						{{ include('evenement/_delete_form.html.twig', {'button_class': 'btn-admin btn-delete'}) }}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}
