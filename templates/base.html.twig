<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/admin-inscriptions.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/navbar-dropdown.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/notifications.css') }}">
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# Affichage des messages flash en bandeaux #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert-banner alert-banner-{{ label == 'success' ? 'success' : 'error' }}">
                    <span>{{ label == 'success' ? '✅' : '❌' }} {{ message }}</span>
                    <button class="close-banner" onclick="this.parentElement.style.display='none'">✕</button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block header %}
            {% include 'base_component/header.html.twig' %}
        {% endblock %}

        {% block main %}
            <main>
                {% include 'base_component/main.html.twig' %}
            </main>
        {% endblock %}

        {% block footer %}
            {% include 'base_component/footer.html.twig' %}
        {% endblock %}
    </body>
</html>
