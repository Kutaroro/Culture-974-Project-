<header>
    <div class="nav-container">
        <a href="/" class="logo">
            🌴 Culture<span>974</span>
        </a>
        
        <nav>
            <ul class="nav-links">
                <li><a href="/" class="{{ app.request.get('_route') == 'home' ? 'active' : '' }}">Accueil</a></li>
                <li><a href="/evenement">Événements</a></li>
                {% if is_granted('ROLE_ADMIN') %}
                    <li><a href="{{ path('admin_inscriptions_index') }}" class="{{ app.request.get('_route') starts with 'admin_inscriptions' ? 'active' : '' }}">Administration</a></li>
                {% endif %}
            </ul>
        </nav>

        <div class="nav-actions">
            {% if is_granted('ROLE_ADMIN') %}
              
                <a href="{{ path('app_logout') }}" class="btn btn-secondary">Déconnexion</a>
            {% else %}
                <a href="{{ path('admin_inscriptions_index') }}" class="btn btn-primary">Connexion </a>
            {% endif %}
        </div>
    </div>
</header>
