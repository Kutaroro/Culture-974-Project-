{% extends 'base.html.twig' %}

{% block title %}Nouvelle Inscription
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/admin-inscriptions.css') }}">
	<link rel="stylesheet" href="{{ asset('styles/modern-forms.css') }}">
{% endblock %}

{% block main %}
<div class="admin-container">
	<div class="form-card">
		<div class="form-header">
			<h1>Inscription</h1>
			{% if evenement is defined %}
				<p>Inscription pour l'événement :
					<strong>{{ evenement.titre }}</strong>
				</p>
			{% else %}
				<p>Veuillez remplir le formulaire pour finaliser votre inscription.</p>
			{% endif %}
		</div>

		{{ form_start(form, {'attr': {'class': 'modern-form'}}) }}
		<div class="form-group">
			{{ form_label(form.name, 'Nom complet') }}
			{{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Jean Dupont'}}) }}
		</div>

		<div class="form-group">
			{{ form_label(form.email, 'Email') }}
			{{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@email.com'}}) }}
		</div>

		<div class="form-group">
			{{ form_label(form.telephone, 'Téléphone') }}
			{{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': '06 92 XX XX XX'}}) }}
		</div>

		<div class="form-group">
			{{ form_label(form.placesNumber, 'Nombre de places') }}
			{{ form_widget(form.placesNumber, {'attr': {'class': 'form-control', 'min': 1}}) }}
		</div>

		<div class="form-group">
			{{ form_label(form.role, 'Rôle / Fonction') }}
			{{ form_widget(form.role, {'attr': {'class': 'form-control'}}) }}
		</div>

		{{ form_widget(form.submit, {'attr': {'class': 'btn-submit'}, 'label': 'Valider l\'inscription'}) }}
        {{ form_end(form) }}

        <div style="text-align: center; margin-top: 1.5rem;">
            {% if evenement is defined %}
                <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" style="color: #6b7280; text-decoration: none; font-size: 0.875rem;">
                    ← Retour à l'événement
                </a>
            {% else %}
                <a href="{{ path('admin_inscriptions_index') }}" style="color: #6b7280; text-decoration: none; font-size: 0.875rem;">
                    ← Retour à la liste
                </a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
